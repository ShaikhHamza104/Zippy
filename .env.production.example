# ==============================================================================
# ZIPPY PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# IMPORTANT: Never commit actual production secrets to source control.
# Copy this template to .env on your production host or configure via
# your cloud platform secrets manager (e.g. Railway, Render, AWS SSM, Doppler).
# ==============================================================================

NODE_ENV=production
PORT=5000
LOG_LEVEL=warn

# Production Public FQDN (Change to your verified domain with HTTPS)
CORS_ORIGIN=https://zippy.yourdomain.com
CLIENT_URL=https://zippy.yourdomain.com

# ------------------------------------------------------------------------------
# Managed MySQL Production Connection (AWS RDS / DigitalOcean / PlanetScale)
# Ensure ?sslaccept=strict or ?sslmode=require is configured on the provider
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://zippy_prod_user:GENERATE_STRONG_DB_PASSWORD@mysql-prod-instance.internal.region.rds.amazonaws.com:3306/zippy_production?sslaccept=strict"

# ------------------------------------------------------------------------------
# Managed MongoDB Atlas Production Connection
# Whitelist production server IP addresses in Atlas Network Access
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://zippy_atlas_user:GENERATE_STRONG_ATLAS_PASS@cluster0.abcde.mongodb.net/zippy_production?retryWrites=true&w=majority&appName=ZippyProd"

# ------------------------------------------------------------------------------
# Production Super Administrator Credentials
# Must use an organizational domain and a strong 16+ char random passphrase
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME="Zippy Operations Admin"
SUPER_ADMIN_EMAIL="security-admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="GENERATE_VERY_STRONG_32_CHAR_ADMIN_PASSPHRASE"

# ------------------------------------------------------------------------------
# Cryptographic JWT Signing Keys (Minimum 32 random characters)
# Generate each unique secret with: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="GENERATE_32_HEX_CHAR_ACCESS_SECRET_VIA_OPENSSL"
JWT_REFRESH_SECRET="GENERATE_32_HEX_CHAR_REFRESH_SECRET_VIA_OPENSSL"
JWT_RESET_PASSWORD_SECRET="GENERATE_32_HEX_CHAR_RESET_SECRET_VIA_OPENSSL"
JWT_EMAIL_VERIFICATION_SECRET="GENERATE_32_HEX_CHAR_VERIFICATION_SECRET_VIA_OPENSSL"

# Cookies: ALWAYS true in production (Requires HTTPS)
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# Production Transactional Email Service (SendGrid / AWS SES / Postmark)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_OR_SES_PRODUCTION_API_KEY
SMTP_FROM="Zippy Support <no-reply@yourdomain.com>"

# ------------------------------------------------------------------------------
# Production Payment Gateway: Razorpay Live Keys
# Generate via Razorpay Dashboard -> Settings -> API Keys (Live Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_HMAC_SECRET

# ------------------------------------------------------------------------------
# Media Storage Provider (s3 or cloudinary recommended for multi-instance production)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
UPLOAD_DIR=uploads
STORAGE_BASE_URL=https://zippy-product-assets.s3.ap-south-1.amazonaws.com

# AWS S3 Production Credentials
AWS_ACCESS_KEY_ID=YOUR_AWS_IAM_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_IAM_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zippy-product-assets
