# ==============================================================================
# ZIPPY MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or .env.development / .env.production
# Generate 32+ char secrets using: openssl rand -hex 32
# ==============================================================================

# Runtime Environment (development | production | test)
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) & Client Address
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# MySQL Relational Database (Prisma ORM)
# Used for: Users, Roles, Addresses, Orders, Order Items, Payments, Audit Logs
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_USER=zippy_user
MYSQL_PASSWORD=replace_with_strong_user_password
MYSQL_DATABASE=zippy_dev
DATABASE_URL="mysql://zippy_user:replace_with_strong_user_password@localhost:3306/zippy_dev"
SHADOW_DATABASE_URL="mysql://zippy_user:replace_with_strong_user_password@localhost:3306/zippy_dev_shadow"

# ------------------------------------------------------------------------------
# MongoDB Document Database (Mongoose ODM)
# Used for: Products, Categories, Variants, Inventory/Stock, Carts, Reviews, Banners
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb://localhost:27017/zippy_dev"

# ------------------------------------------------------------------------------
# Initial Super Administrator Account (Provisioned on first database seed)
# In production, use a strong password (12+ chars, mixed case, numbers, symbols)
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME="Hamza Shaikh"
SUPER_ADMIN_EMAIL="admin@zippy.com"
SUPER_ADMIN_PASSWORD=replace_with_strong_admin_password

# ------------------------------------------------------------------------------
# Cryptographic Security & JSON Web Tokens (Secrets MUST be >= 32 characters)
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_at_least_32_char_random_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_char_random_refresh_secret
JWT_RESET_PASSWORD_SECRET=replace_with_at_least_32_char_random_reset_secret
JWT_EMAIL_VERIFICATION_SECRET=replace_with_at_least_32_char_random_verification_secret

# Cookie Security (Set to true in production with HTTPS)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Transactional Email Service (SMTP)
# Optional in development; falls back to formatted console notifications
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zippy Quick Commerce <no-reply@zippy.com>"

# ------------------------------------------------------------------------------
# Payment Gateway: Razorpay
# Test mode supported out-of-the-box; mock checkout active when empty in dev/test
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ------------------------------------------------------------------------------
# Media Storage Provider (local | s3 | cloudinary)
# In production, configure S3 or Cloudinary for distributed image assets
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
STORAGE_BASE_URL=

# Optional S3 Configuration (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zippy-product-assets

# Optional Cloudinary Configuration (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
