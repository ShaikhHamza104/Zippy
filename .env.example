# Zippy Environment Variables Template
NODE_ENV=development
PORT=5000

# MySQL (Prisma)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_USER=zippy_user
MYSQL_PASSWORD=replace_with_strong_user_password
MYSQL_DATABASE=zippy_dev
DATABASE_URL="mysql://zippy_user:replace_with_strong_user_password@localhost:3306/zippy_dev"
SHADOW_DATABASE_URL="mysql://zippy_user:replace_with_strong_user_password@localhost:3306/zippy_dev_shadow"

# MongoDB (Mongoose)
MONGODB_URI=mongodb://localhost:27017/zippy_dev

# Super Admin Seed Credentials
SUPER_ADMIN_NAME="Hamza Shaikh"
SUPER_ADMIN_EMAIL="admin@zippy.com"
SUPER_ADMIN_PASSWORD=replace_with_strong_admin_password

# Authentication & Security (Secrets must be at least 32 characters)
JWT_ACCESS_SECRET="replace_with_at_least_32_char_random_secret"
JWT_REFRESH_SECRET="replace_with_at_least_32_char_random_secret"
JWT_RESET_PASSWORD_SECRET="replace_with_at_least_32_char_random_secret"
JWT_EMAIL_VERIFICATION_SECRET="replace_with_at_least_32_char_random_secret"
COOKIE_SECURE="false"
CLIENT_URL="http://localhost:5173"

# Email Service (SMTP) - Optional in dev (falls back to console log)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Zippy <no-reply@zippy.com>"

# Razorpay Payment Gateway - Optional in dev/test (simulated mode active)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="replace_with_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_secret"

# Media Storage Provider (local / s3 / cloudinary)
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
STORAGE_BASE_URL=""


