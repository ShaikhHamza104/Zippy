# ==============================================================================
# ZIPPY DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.development)
# Pre-configured for local workstation development with Docker or local daemons
# ==============================================================================

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Frontend Dev Server URL
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# MySQL Local Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=zippy_root_dev_pass
MYSQL_USER=zippy_user
MYSQL_PASSWORD=zippy_user_dev_pass
MYSQL_DATABASE=zippy_dev
DATABASE_URL="mysql://zippy_user:zippy_user_dev_pass@localhost:3306/zippy_dev"
SHADOW_DATABASE_URL="mysql://zippy_user:zippy_user_dev_pass@localhost:3306/zippy_dev_shadow"

# MongoDB Local Connection
MONGODB_URI="mongodb://localhost:27017/zippy_dev"

# Development Super Admin Seed Account
SUPER_ADMIN_NAME="Hamza Shaikh"
SUPER_ADMIN_EMAIL="admin@zippy.com"
SUPER_ADMIN_PASSWORD="StrongDevPassword#2026"

# Development JWT Secrets (32+ characters each)
JWT_ACCESS_SECRET="dev_only_jwt_access_secret_min_32_characters_long_zippy_app"
JWT_REFRESH_SECRET="dev_only_jwt_refresh_secret_min_32_characters_long_zippy_app"
JWT_RESET_PASSWORD_SECRET="dev_only_jwt_reset_secret_min_32_characters_long_zippy_app"
JWT_EMAIL_VERIFICATION_SECRET="dev_only_jwt_verify_secret_min_32_characters_long_zippy_app"

# Cookies: false allows HTTP localhost cookies
COOKIE_SECURE=false

# Email: empty in development logs emails to terminal console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zippy Dev <no-reply@zippy.test>"

# Razorpay: simulated mock mode in development
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_for_local_testing_only
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder_local

# Storage: local file system in development
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
STORAGE_BASE_URL=http://localhost:5000/uploads
