{
  "name": "zippy-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"pnpm --filter @zippy/server dev\" \"pnpm --filter @zippy/client dev\"",
    "dev:server": "pnpm --filter @zippy/server dev",
    "dev:client": "pnpm --filter @zippy/client dev",
    "build": "pnpm --filter @zippy/client build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.js",
    "seed": "pnpm --filter @zippy/server seed",
    "prisma:status": "pnpm --filter @zippy/server prisma:status",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.64.1",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "type": "module"
}
